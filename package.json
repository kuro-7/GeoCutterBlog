{
  "name": "nextjs-simple-blog-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --test",
    "check": "npm run test && npm run build",
    "preview": "opennextjs-cloudflare build --env=staging && opennextjs-cloudflare preview --env=staging",
    "deploy:staging": "opennextjs-cloudflare build --env=staging && opennextjs-cloudflare deploy --env=staging",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "image:upload": "node scripts/upload-image.mjs",
    "format": "prettier --write --ignore-path .gitignore './**/*.{js,mjs,ts,tsx,json,jsonc,css,md}'"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "printWidth": 100
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.18",
    "eslint-config-prettier": "^10.1.1",
    "microcms-js-sdk": "^3.4.0",
    "next": "^15.5.18",
    "prettier": "^3.5.3",
    "react": "^19.2.4",
    "react-markdown": "10.1.0",
    "react-dom": "^19.2.4",
    "remark-gfm": "4.0.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "wrangler": "4.105.0"
  }
}
